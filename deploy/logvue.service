[Unit]
Description=LogVue Backend (Ktor)

After=network.target

[Service]
Type=simple
WorkingDirectory=__DEPLOY_PATH__
ExecStart=/usr/bin/java -jar __DEPLOY_PATH__/backend/build/libs/backend-0.1.0-all.jar
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/logvue/stdout.log
StandardError=append:/var/log/logvue/stderr.log

# Run as non-root user (create 'logvue' user first)
# User=logvue

[Install]
WantedBy=multi-user.target